                "import numpy as np\n",
                "import tensorflow as tf\n",
                "import os\n",
                "import pandas as pd\n",
                "import numpy as np\n",
                "import pickle\n",
                "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
                "import tensorflow as tf\n",
                "from abc import ABC, abstractmethod\n",
                "\n",
                "class DL_Model:\n",
                "    def __init__(self, **kwargs):\n",
                "        # The benchmark framework will pass the model constructor as a keyword argument\n",
                "        # based on the subpart name in the experiment design\n",
                "        self.model_constructor = kwargs.get('classifier', None)\n",
                "        self.multi_horizon = False #(default)\n",
                "        self.hp = 1  # History points (default)\n",
                "        self.hf = 1  # Future points (default)\n",
                "        self.model = None\n",
                "        self.batch_size = 512\n",
                "        self.epochs = 50\n",
                "        self.w = 60\n",
                "        self.verbose = 2\n",
                "        self.has_context = True  # Set based on your data\n",
                "        \n",
                "        # Debug print to see what we're receiving\n",
                "        print(f\"DL_Model initialized with kwargs: {list(kwargs.keys())}\")\n",
                "        for key, value in kwargs.items():\n",
                "            print(f\"  {key}: {type(value)}\")\n",
                "        \n",
                "    def _tuning(self, X, y, context=None, **kwargs):\n",
                "        # No tuning needed for this case\n",
                "        pass\n",
                "\n",
                "    def encode_labels(self, Y):\n",
                "        \"\"\"\n",
                "        One-hot encode labels.\n",
                "        \n",
                "        Args:\n",
                "            Y (numpy.ndarray): Labels to encode\n",
                "            \n",
                "        Returns:\n",
                "            numpy.ndarray: One-hot encoded labels\n",
                "        \"\"\"\n",
                "        if Y.ndim == 1:  # Single time step labels\n",
                "            unique_labels = np.unique(Y)\n",
                "            enc = OneHotEncoder(categories=[unique_labels], sparse_output=False)\n",
                "            Y_reshaped = Y.reshape(-1, 1)\n",
                "            enc.fit(Y_reshaped)\n",
                "            Y_encoded = enc.transform(Y_reshaped)\n",
                "            return Y_encoded\n",
                "        \n",
                "        elif Y.ndim == 2:  # Multi-horizon labels [samples, time_steps]\n",
                "            # Get all unique labels across all time steps\n",
                "            unique_labels = np.unique(Y.flatten())\n",
                "            enc = OneHotEncoder(categories=[unique_labels], sparse_output=False)\n",
                "            \n",
                "            # Encode each time step\n",
                "            Y_encoded = np.zeros((Y.shape[0], Y.shape[1], len(unique_labels)))\n",
                "            for t in range(Y.shape[1]):\n",
                "                Y_t_reshaped = Y[:, t].reshape(-1, 1)\n",
                "                Y_encoded[:, t, :] = enc.transform(Y_t_reshaped)\n",
                "            \n",
                "            return Y_encoded\n",
                "        \n",
                "        else:\n",
                "            raise ValueError(f\"Unsupported Y shape: {Y.shape}\")\n",
                "\n",
                "    def prepare_multi_horizon(self, X, Y, context, subject_splits=None, encode_labels=True, **kwargs):\n",
                "        \"\"\"\n",
                "        Transform data for multi-horizon prediction.\n",
                "        \"\"\"\n",
                "        # Set multi-horizon parameters from model constructor\n",
                "        if self.model_constructor and \"parameters\" in self.model_constructor:\n",
                "            self.multi_horizon = self.model_constructor[\"parameters\"].get(\"multi_horizon\", False)\n",
                "            self.hf = self.model_constructor[\"parameters\"].get(\"h_f\", 1)\n",
                "            self.hp = self.model_constructor[\"parameters\"].get(\"h_p\", 1)\n",
                "        \n",
                "        if not self.multi_horizon:\n",
                "            if encode_labels:\n",
                "                # Still encode labels even if not multi-horizon\n",
                "                Y = self.encode_labels(Y)\n",
                "            return X, Y, context\n",
                "        \n",
                "        # Check if we have subject_splits\n",
                "        if subject_splits is None:\n",
                "            print(\"Warning: subject_splits not provided, cannot create proper multi-horizon sequences\")\n",
                "            # Fallback: encode labels and return as-is\n",
                "            if encode_labels:\n",
                "                Y = self.encode_labels(Y)\n",
                "            return X, Y, context\n",
                "        \n",
                "        if X.ndim == 3 and self.hp > 1:\n",
                "            # Already windowed data - treat each window as a sequence\n",
                "            print(\"Warning: Applying multi-horizon to already windowed data.\")\n",
                "            raise NotImplementedError(\"Multi-horizon on pre-windowed data is not implemented.\")\n",
                "        \n",
                "        X_multi = []\n",
                "        Y_multi = []\n",
                "        context_multi = []\n",
                "        splits_multi = []\n",
                "        valid_indices = []\n",
                "        \n",
                "        # Encode labels if requested\n",
                "        if encode_labels:\n",
                "            Y = self.encode_labels(Y)\n",
                "\n",
                "        # Create sequences with history and multiple future predictions\n",
                "        for j in range(len(Y) - self.hp - self.hf + 1):\n",
                "            # Check if this sequence spans multiple subjects (which we want to avoid)\n",
                "            subjects_in_sequence = subject_splits[j:j+self.hp+self.hf]\n",
                "            if len(np.unique(subjects_in_sequence)) == 1:  # All from same subject\n",
                "                X_multi.append(X[j:j+self.hp])  # History points\n",
                "                Y_multi.append(Y[j+self.hp:j+self.hp+self.hf])  # Future labels\n",
                "                \n",
                "                # Handle context - might be empty for dataset v0\n",
                "                if self.has_context and context is not None:\n",
                "                    context_multi.append(context[j+self.hp:j+self.hp+self.hf])\n",
                "                else:\n",
                "                    # Create empty context with correct shape\n",
                "                    if context is not None and context.ndim > 1:\n",
                "                        empty_context = np.array([]).reshape(self.hf, context.shape[1])\n",
                "                    else:\n",
                "                        empty_context = np.array([]).reshape(self.hf, 0)\n",
                "                    context_multi.append(empty_context)\n",
                "                \n",
                "                splits_multi.append(subject_splits[j+self.hp])  # Subject ID  \n",
                "                valid_indices.append(j)\n",
                "        \n",
                "        if not X_multi:\n",
                "            raise ValueError(\"No valid multi-horizon sequences could be created\")\n",
                "        \n",
                "        # Convert to numpy arrays\n",
                "        X_multi = np.array(X_multi)\n",
                "        Y_multi = np.array(Y_multi)\n",
                "        if context_multi and len(context_multi[0]) > 0:\n",
                "            context_multi = np.array(context_multi)\n",
                "        else:\n",
                "            context_multi = None\n",
                "\n",
                "        return X_multi, Y_multi, context_multi\n",
                "    \n",
                "    def fit(self, X, y, context=None, **kwargs):\n",
                "        \"\"\"\n",
                "        Fit the model. The benchmark framework will pass target_arg through kwargs.\n",
                "        \"\"\"\n",
                "        # Clear session before creating new model\n",
                "        tf.keras.backend.clear_session() \n",
                "        w = kwargs.get('w', self.w)\n",
                "        \n",
                "        # Debug print to see what we're receiving\n",
                "        print(f\"fit() received kwargs: {list(kwargs.keys())}\")\n",
                "        print(f\"fit() kwargs content: {kwargs}\")\n",
                "        \n",
                "        # Extract subject_splits from kwargs (passed via target_arg)\n",
                "        subject_splits = kwargs.get('subject_splits', None)\n",
                "        \n",
                "        if subject_splits is not None:\n",
                "            print(f\"subject_splits found! Shape: {np.array(subject_splits).shape}\")\n",
                "            print(f\"subject_splits type: {type(subject_splits)}\")\n",
                "            # Print first few values to debug\n",
                "            if hasattr(subject_splits, '__len__') and len(subject_splits) > 0:\n",
                "                print(f\"First 10 subject_splits values: {subject_splits[:10]}\")\n",
                "        else:\n",
                "            print(\"Warning: subject_splits not found in kwargs\")\n",
                "        \n",
                "        # Prepare data for multi-horizon if needed\n",
                "        X, y, context = self.prepare_multi_horizon(X, y, context, subject_splits=subject_splits)\n",
                "        \n",
                "        # Initialize the model if it doesn't exist\n",
                "        if self.model is None:\n",
                "            if self.model_constructor is None:\n",
                "                raise ValueError(f\"Model constructor not found. Available kwargs: {list(kwargs.keys())}\")\n",
                "            \n",
                "            print(f\"Creating model with constructor: {self.model_constructor}\")\n",
                "            \n",
                "            # Set parameters from constructor\n",
                "            if \"parameters\" in self.model_constructor:\n",
                "                self.multi_horizon = self.model_constructor[\"parameters\"].get(\"multi_horizon\", False)\n",
                "                self.hf = self.model_constructor[\"parameters\"].get(\"h_f\", 1)\n",
                "                self.hp = self.model_constructor[\"parameters\"].get(\"h_p\", 1)\n",
                "            \n",
                "            # Create model based on whether it's multi-horizon\n",
                "            if self.hf > 1: \n",
                "                metadata = [w, w//2, self.hp]\n",
                "                X = np.reshape(X, (X.shape[0],X.shape[1] * X.shape[2] , X.shape[3]))\n",
                "                self.model = self.model_constructor[\"initializer\"](X, y, metadata)\n",
                "            else: \n",
                "                self.model = self.model_constructor[\"initializer\"](X, y)\n",
                "        \n",
                "        # Get training parameters\n",
                "        batch_size = kwargs.get('batch_size', self.batch_size)\n",
                "        epochs = kwargs.get('epochs', self.epochs)\n",
                "        \n",
                "        # Train the model\n",
                "        print(f\"Training model with batch_size={batch_size}, epochs={epochs}\")\n",
                "        print(f\"Training data shapes - X: {X.shape}, y: {y.shape}\")\n",
                "        \n",
                "        history = self.model.fit(\n",
                "            X, y,\n",
                "            batch_size=batch_size, \n",
                "            epochs=epochs,\n",
                "            verbose=self.verbose\n",
                "        )\n",
                "        return history\n",
                "    \n",
                "    def predict(self, X, context=None, **kwargs):\n",
                "        \"\"\"\n",
                "        Predict using the trained model.\n",
                "        \"\"\"\n",
                "        if self.model is None:\n",
                "            raise ValueError(\"Model must be trained before prediction\")\n",
                "        \n",
                "        # Extract subject_splits from kwargs for prediction too\n",
                "        subject_splits = kwargs.get('subject_splits', None)\n",
                "        \n",
                "        # Note: We don't have y during prediction, so we can't do full multi-horizon prep\n",
                "        if self.multi_horizon and subject_splits is not None:\n",
                "            print(\"Warning: Multi-horizon prediction requires special handling\")\n",
                "            \n",
                "        return self.model.predict(X, batch_size=self.batch_size, verbose=0)\n",
                "\n",
                "    def save(self, storing, keys):\n",
                "        \"\"\"Save in compatible format\"\"\"\n",
                "        pass\n",
                "    \n",
                "    def load(self, storing, keys):\n",
                "        \"\"\"Load from their system\"\"\"  \n",
                "        pass\n",
                "\n",
                "    def reset(self):\n",
                "        \"\"\"Reset the model state\"\"\"\n",
                "        if self.model is not None:\n",
                "            del self.model\n",
                "            self.model = None\n",
                "        tf.keras.backend.clear_session()\n",
                "        \n",
                "    def delete(self):\n",
                "        \"\"\"Clean up resources\"\"\"\n",
                "        self.reset()"
            ]
        },
