                "\n",
                "        print(\"shape of y at the start :\", y.shape)\n",
                "        print(\"shape of output at the start :\", output.shape)\n",
                "        print(\"shape of context at the start :\", context.shape)\n",
                "        \n",
                "        valid_test_types = {\"regular\", \"first static\", \"transition\", \"second static\"}\n",
                "        invalid_types = set(self.test_type_list) - valid_test_types\n",
                "        if invalid_types:\n",
                "            raise ValueError(f\"Invalid test_type: {invalid_types}. Choose from {valid_test_types}\") \n",
                "    \n",
                "        # In case of multi-step, we only use the current timestep\n",
                "        if output.ndim == 3 : \n",
                "            output = output.transpose(1, 0, 2) \n",
                "            output = output[0] \n",
                "\n",
                "        print(\"values of y :\", y[:40]) \n",
                "        print(\"values of context :\", context[:40])\n",
                "        \n",
                "        # Store raw probabilities for modified accuracy with threshold\n",
                "        output_probs = output  # Raw probabilities before argmax\n",
                "        Y_pred = np.argmax(output, axis=1)\n",
                "        Y_pred = Y_pred \n",
                "        Y_test = y - 1\n",
                "    \n",
                "        for test_mask in sets: \n",
                "            Y_pred_labels = Y_pred[test_mask] \n",
                "            Y_test_labels = Y_test[test_mask] \n",
                "            \n",
                "            # Extract probability arrays for test and train sets\n",
                "            output_probs_test = output_probs[test_mask]\n",
