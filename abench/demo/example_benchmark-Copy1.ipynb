                "from sklearn.metrics import classification_report, accuracy_score\n",
                "from sklearn.preprocessing import OneHotEncoder  \n",
                "import numpy as np\n",
                "\n",
                "class AccuracyMetric: \n",
                "    def __init__(self, **kwargs):\n",
                "        # Get the test type \n",
                "        self.test_type_list = kwargs.get('test_type_list', [\"regular\", \"first static\", \"transition\", \"second static\"])\n",
                "        # Add name of the metric\n",
                "        self.name = \"_\".join(s.replace(\" \", \"_\") for s in self.test_type_list) + \"_accuracy\"\n",
                "        # Add parameter to choose between normal and modified accuracy\n",
                "        self.use_modified_accuracy = kwargs.get('use_modified_accuracy', False)\n",
                "        # Add threshold for probability-based accuracy in transitions\n",
                "        self.prob_threshold = kwargs.get('prob_threshold', 0.8)\n",
                "        # Add has_context attribute\n",
                "        self.has_context = kwargs.get('has_context', True)\n",
                "        \n",
                "    def modified_acc(self, y_test, y_pred, c_test, prev_static_labels=None, pred_probs=None,\n",
                "                     prob_threshold=0.8):\n",
                "        \"\"\"\n",
                "        Calculate modified accuracy that handles transition phases differently:\n",
                "        - In static phases (c_test=0): Prediction must exactly match the true label\n",
                "        - In transition phases (c_test>0): Prediction can match either previous static phase or\n",
                "          the current y_test value (which is already the next static phase label)\n",
                "        - For transitions with probabilities: Sum of probabilities for previous and current class\n",
                "          must exceed prob_threshold to be considered correct\n",
                "        \n",
                "        Args:\n",
                "            y_test: Array of true labels (for transitions, already contains the next static phase label)\n",
                "            y_pred: Array of predicted labels\n",
                "            c_test: Array indicating phase type (0=static, >0=transition)\n",
                "            prev_static_labels: Optional array of previous static phase labels for each data point\n",
                "                                (used when analyzing specific phases)\n",
                "            pred_probs: Optional array of prediction probabilities (shape: [n_samples, n_classes])\n",
                "            prob_threshold: Threshold for sum of probabilities in transition phases (default: 0.8)\n",
                "            \n",
                "        Returns:\n",
                "            Modified accuracy score\n",
                "        \"\"\"\n",
                "        print(\"shape of y_pred : \", y_pred.shape)\n",
                "        print(\"shape of y_test : \", y_test.shape)\n",
                "        print(\"shape of c_test : \", c_test.shape)\n",
                "        \n",
                "        if len(y_test) != len(y_pred) or len(y_test) != len(c_test):\n",
                "            raise ValueError(\"Input arrays must have the same length\")\n",
                "            \n",
                "        TP = 0\n",
                "        TOT = len(y_test)\n",
                "        # If we don't have pre-computed previous static labels, calculate them\n",
                "        if prev_static_labels is None:\n",
                "            # Keep track of previous static label for transition phase handling\n",
                "            prev_static_label = None\n",
                "            prev_static_labels = np.full(len(y_test), None, dtype=object)\n",
                "            \n",
                "            # First pass: identify all static phases and record their labels\n",
                "            for i in range(len(y_test)):\n",
                "                if c_test[i] == 0 or c_test[i] == -1:  # Static phase\n",
                "                    prev_static_label = y_test[i]\n",
                "                prev_static_labels[i] = prev_static_label\n",
                "        \n",
                "        # Now calculate accuracy with knowledge of previous static labels\n",
                "        for i in range(len(y_test)):\n",
                "            if c_test[i] == 0 or c_test[i] == -1:  # Static phase\n",
                "                # In static phase, prediction must match exactly\n",
                "                if y_pred[i] == y_test[i]:\n",
                "                    TP += 1\n",
                "            else:  # Transition phase\n",
                "                # For transition: y_test[i] already has the next static phase label\n",
                "                prev_label = prev_static_labels[i]\n",
                "                \n",
                "                # Check if prediction matches either previous or current label\n",
                "                pred_matches = (prev_label is not None and y_pred[i] == prev_label) or y_pred[i] == y_test[i]\n",
                "                \n",
                "                if pred_matches:\n",
                "                    # If we have probability information, check threshold\n",
                "                    if pred_probs is not None:\n",
                "                        prev_prob = pred_probs[i, prev_label] if prev_label is not None else 0.0\n",
                "                        current_prob = pred_probs[i, y_test[i]]\n",
                "                        \n",
                "                        # Sum of probabilities for previous and current class must exceed threshold\n",
                "                        if prev_prob + current_prob >= prob_threshold:\n",
                "                            TP += 1\n",
                "                    else:\n",
                "                        # No probability information, just count as correct\n",
                "                        TP += 1\n",
                "        \n",
                "        acc = TP / TOT if TOT > 0 else 0\n",
                "        return acc\n",
                "\n",
                "    def compute(self, y, output, context, target_arg, sets=None, **kwargs): \n",
                "        if(sets is None):\n",
                "            sets = [np.ones(len(y))==1] \n",
                "        print(\"##################### TEST TIME ########################\")\n",
